{
  "opencollection": "1.0.0",
  "info": {
    "name": "OneSchema AWS Secrets Manager AWS Secrets Manager Accounts S3 Accounts API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "S3 Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List S3 Accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.oneschema.co/v0/s3-accounts"
          },
          "docs": "Returns a list of S3 Accounts connected to the organization."
        },
        {
          "info": {
            "name": "Create S3 Account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.oneschema.co/v0/s3-accounts",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new S3 Account connected to OneSchema."
        },
        {
          "info": {
            "name": "Get S3 Account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.oneschema.co/v0/s3-accounts/:s3-account-id",
            "params": [
              {
                "name": "s3-account-id",
                "value": "",
                "type": "path",
                "description": "The ID of the S3 Account"
              }
            ]
          },
          "docs": "Get a specific S3 Account connected to the organization."
        },
        {
          "info": {
            "name": "Delete S3 Account",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.oneschema.co/v0/s3-accounts/:s3-account-id",
            "params": [
              {
                "name": "s3-account-id",
                "value": "",
                "type": "path",
                "description": "The ID of the S3 Account"
              }
            ]
          },
          "docs": "Delete a specific S3 Account connected to the organization."
        }
      ]
    }
  ],
  "bundled": true
}