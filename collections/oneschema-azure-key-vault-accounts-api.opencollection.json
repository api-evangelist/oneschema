            "params": [
              {
                "name": "account-id",
                "value": "",
                "type": "path",
                "description": "The ID of the Azure Key Vault account"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Test that OneSchema can authenticate via the configured App Registration and retrieve a specific secret. The secret value is not returned."
