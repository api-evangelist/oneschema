            "url": "https://api.oneschema.co/v0/azure-key-vault/accounts/:account-id",
            "params": [
              {
                "name": "account-id",
                "value": "",
                "type": "path",
                "description": "The ID of the Azure Key Vault account"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a specific Azure Key Vault account connection."
        },
        {
          "info": {
            "name": "Delete Azure Key Vault Account",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.oneschema.co/v0/azure-key-vault/accounts/:account-id",
            "params": [
              {
                "name": "account-id",
                "value": "",
                "type": "path",
                "description": "The ID of the Azure Key Vault account"
              }
            ]
          },
          "docs": "Delete a specific Azure Key Vault account connection. The account cannot be deleted while it has managed secrets attached."
