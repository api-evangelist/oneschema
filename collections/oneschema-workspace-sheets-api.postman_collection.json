          "id": "96e7de69-ff8e-4d7b-8491-9b65b071b5d0",
          "name": "Assign a template to a Workspace sheet",
          "request": {
            "name": "Assign a template to a Workspace sheet",
            "description": {
              "content": "Assign or unassign a template for a Workspace sheet. Pass `template_key: null` to unassign the current template.\n\nSet `auto_set_header_row` to `true` to automatically detect and set the header row before applying the template. If the sheet's headers are already set, `auto_set_header_row` is ignored.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "sheets",
                ":sheet_id",
                "template"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "sheet_id",
                  "description": "(Required) The id of the sheet."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"template_key\": \"<string,null>\",\n  \"auto_set_header_row\": \"<boolean>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
