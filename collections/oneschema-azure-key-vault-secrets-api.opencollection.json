{
  "opencollection": "1.0.0",
  "info": {
    "name": "OneSchema AWS Secrets Manager AWS Secrets Manager Accounts Azure Key Vault Secrets API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Azure Key Vault Secrets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Managed Secrets for Account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.oneschema.co/v0/azure-key-vault/accounts/:account-id/secrets",
            "params": [
              {
                "name": "account-id",
                "value": "",
                "type": "path",
                "description": "The ID of the Azure Key Vault account"
              }
            ]
          },
          "docs": "Returns all managed secrets belonging to a specific Azure Key Vault account."
        },
        {
          "info": {
            "name": "Create Managed Secret",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.oneschema.co/v0/azure-key-vault/accounts/:account-id/secrets",
            "params": [
              {
                "name": "account-id",
                "value": "",
                "type": "path",
                "description": "The ID of the Azure Key Vault account"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new managed secret reference within an Azure Key Vault account."
        },
        {
          "info": {
            "name": "Get Managed Secret",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.oneschema.co/v0/azure-key-vault/secrets/:secret-id",
            "params": [
              {
                "name": "secret-id",
                "value": "",
                "type": "path",
                "description": "The ID of the managed secret"
              }
            ]
          },
          "docs": "Get a specific managed secret."
        },
        {
          "info": {
            "name": "Update Managed Secret",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.oneschema.co/v0/azure-key-vault/secrets/:secret-id",
            "params": [
              {
                "name": "secret-id",
                "value": "",
                "type": "path",
                "description": "The ID of the managed secret"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a specific managed secret."
        },
        {
          "info": {
            "name": "Delete Managed Secret",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.oneschema.co/v0/azure-key-vault/secrets/:secret-id",
            "params": [
              {
                "name": "secret-id",
                "value": "",
                "type": "path",
                "description": "The ID of the managed secret"
              }
            ]
          },
          "docs": "Delete a specific managed secret."
        },
        {
          "info": {
            "name": "List All Managed Secrets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.oneschema.co/v0/azure-key-vault/secrets"
          },
          "docs": "Returns all Azure managed secrets across all accounts in the organization."
        }
      ]
    }
  ],
  "bundled": true
}