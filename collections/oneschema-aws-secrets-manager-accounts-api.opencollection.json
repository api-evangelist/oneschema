          },
          "http": {
            "method": "GET",
            "url": "https://api.oneschema.co/v0/aws-secrets-manager/accounts"
          },
          "docs": "Returns a list of AWS Secrets Manager account connections for the organization."
        },
        {
          "info": {
            "name": "Create AWS Secrets Manager Account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.oneschema.co/v0/aws-secrets-manager/accounts",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new AWS Secrets Manager account connection for the organization."
        },
        {
          "info": {
            "name": "Get AWS Secrets Manager Account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.oneschema.co/v0/aws-secrets-manager/accounts/:account-id",
            "params": [
              {
                "name": "account-id",
                "value": "",
                "type": "path",
                "description": "The ID of the AWS Secrets Manager account"
              }
            ]
          },
          "docs": "Get a specific AWS Secrets Manager account connection."
        },
        {
          "info": {
            "name": "Update AWS Secrets Manager Account",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.oneschema.co/v0/aws-secrets-manager/accounts/:account-id",
            "params": [
              {
                "name": "account-id",
                "value": "",
                "type": "path",
                "description": "The ID of the AWS Secrets Manager account"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a specific AWS Secrets Manager account connection."
        },
        {
          "info": {
            "name": "Delete AWS Secrets Manager Account",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.oneschema.co/v0/aws-secrets-manager/accounts/:account-id",
            "params": [
              {
                "name": "account-id",
                "value": "",
                "type": "path",
                "description": "The ID of the AWS Secrets Manager account"
              }
            ]
          },
          "docs": "Delete a specific AWS Secrets Manager account connection. The account cannot be deleted while it has managed secrets attached."
        },
        {
          "info": {
            "name": "Test AWS Secrets Manager Connection",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.oneschema.co/v0/aws-secrets-manager/accounts/:account-id/test",
            "params": [
              {
                "name": "account-id",
                "value": "",
                "type": "path",
                "description": "The ID of the AWS Secrets Manager account"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Test that OneSchema can authenticate via the configured IAM role and retrieve a specific secret. The secret value is not returned."
        }
      ]
    }
  ],
  "bundled": true
